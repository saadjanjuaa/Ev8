{
  "expo": {
    "name": "EV8",
    "slug": "ev8",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070C",
    "scheme": "ev8",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ev8.enginesound",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "EV8 bruker posisjonen din til å måle farten, slik at motorlyden følger kjøringen.",
        "NSMotionUsageDescription": "EV8 bruker bevegelsessensoren til å merke akselerasjon med én gang, i stedet for å vente på neste GPS-punkt."
      }
    },
    "android": {
      "package": "com.ev8.enginesound",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070C"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "HIGH_SAMPLING_RATE_SENSORS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#07080C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EV8 bruker posisjonen din til å måle farten, slik at motorlyden følger kjøringen."
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
